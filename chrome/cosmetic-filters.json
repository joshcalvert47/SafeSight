{
    "description": "Shipped generic cosmetic filters. Deliberately short and conservative: generic element hiding is the classic way to break a working site, so every entry here targets ad scaffolding (a container with an ad-shaped name or marker) and never a plain img, video, or layout wrapper. User zaps and picks live in chrome.storage.local.userCSS and are applied per host.",
    "selectors": [
        ".adsbygoogle",
        "[id^=\"google_ads_iframe\"]",
        "[id^=\"aswift_\"]",
        "iframe[name^=\"google_ads_iframe\"]",
        "iframe[id^=\"google_ads_iframe\"]",
        "[id^=\"div-gpt-ad\"]",
        "[class^=\"div-gpt-ad\"]",
        "[id^=\"ad-slot\"]",
        "[id^=\"ad_slot\"]",
        ".ad-slot",
        ".ad-banner",
        ".ad-container",
        ".advertisement",
        ".advertisment",
        "[class*=\"advert-\"]",
        "[class*=\"-advert\"]",
        "[class^=\"sponsored-\"]",
        ".sponsored-content",
        ".sponsored-post",
        "[data-ad-slot]",
        "[data-ad-client]",
        "[data-ad-unit]",
        "[data-google-ad]",
        "[data-advertisement]",
        ".taboola",
        "[id^=\"taboola\"]",
        ".OUTBRAIN",
        "[class^=\"outbrain\"]",
        "[id^=\"outbrain_widget\"]",
        ".mgid-widget",
        "[id^=\"mgid\"]",
        ".adthrive-ad",
        "[class^=\"adthrive-\"]",
        "[id^=\"ezoic-pub-ad\"]",
        ".ezoic-ad",
        "[class*=\"ezoic-ad\"]",
        "[id^=\"amznassoc\"]",
        ".amazon-ad",
        "[id^=\"criteo\"]",
        "iframe[src*=\"doubleclick.net\"]",
        "iframe[src*=\"googlesyndication.com\"]",
        "iframe[src*=\"adservice.google\"]",
        "iframe[src*=\"/ads/\"]",
        "iframe[src*=\"adserver\"]",
        "iframe[src*=\"adsystem\"]"
    ]
}
